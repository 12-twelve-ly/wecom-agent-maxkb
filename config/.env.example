# 复制为 .env 后填写；config.toml 里的 ${VAR} 会从这里读取。
# 旧版单机器人模式也直接读取这些变量。

# 企微智能机器人（API 模式）
WECOM_BOT_ID=
WECOM_SECRET=

# MaxKB 连接
MAXKB_API_BASE=http://localhost:8081

# 方式一：应用分享链接里的 access_token
MAXKB_ACCESS_TOKEN=

# 方式二：应用 API Key（application- 或 agent- 开头）
# MAXKB_AUTH_MODE=api_key
# MAXKB_API_KEY=
# MAXKB_APPLICATION_ID=

# 可选：旧 .env 模式下自定义文案
# BOT_DISPLAY_NAME=知识助手
# BOT_WELCOME=
# BOT_MENU=
# BOT_RESET=
# BOT_MAX_CONTEXT=10

# 可选：usage_report.py 访问 MaxKB 数据库
# MAXKB_DB_CONTAINER=maxkb
# MAXKB_DB_USER=root
# MAXKB_DB_NAME=maxkb
